// Containers: one fixed-size value type, four heap containers, and one
// spelling for every operation that all of them share. Every verb lives in
// `binz/container` and is reached through it, so `size` on a container and
// `size` on a str are never the same name resolving two ways.

import binz/io;
import binz/string;
import binz/container;

function line(label: str, text: str): void {
    io.print(label + ": " + text);
    return;
}

// A fixed array is a value, so this receives a copy.
function total(xs: [i32; 5]): i32 {
    var i: i32 = 0;
    var sum: i32 = 0;
    while (i < container.size(xs)) {
        sum = sum + xs[i];
        i = i + 1;
    }
    return sum;
}

// A heap container is a handle, so this mutates the caller's vector.
function fill(v: Vector<i32>, upto: i32): void {
    var i: i32 = 0;
    while (i < upto) {
        container.push(v, i * i);
        i = i + 1;
    }
    return;
}

function join(v: Vector<str>): str {
    var out: str = "";
    var i: i32 = 0;
    while (i < container.size(v)) {
        out = out + v[i];
        if (i < container.size(v) - 1) {
            out = out + ", ";
        }
        i = i + 1;
    }
    return out;
}

function main(): i32 {
    io.print("-- binZ containers --");

    // ------------------------------------------------- [T; N], a value type
    // Every element is written out, exactly like a struct literal.
    var scores: [i32; 5] = [7, 3, 9, 1, 5];
    scores[0] = 10;
    line("scores[0]", cast<str>(scores[0]));
    line("total", cast<str>(total(scores)));
    line("find 9", cast<str>(container.find(scores, 9)));

    // `[x; N]` repeats one value; it is the only other array literal.
    var grid: [[i32; 3]; 2] = [[0; 3]; 2];
    grid[1][2] = 4;
    line("grid[1][2]", cast<str>(grid[1][2]));

    // Arrays copy, and an element has an address like any other place.
    var copyOfScores: [i32; 5] = scores;
    copyOfScores[0] = 0;
    const first: *i32 = &scores[0];
    line("original after copy", cast<str>(*first));

    // ------------------------------------------------ Vector<T>, contiguous
    var squares: Vector<i32> = Vector<i32>{};
    fill(squares, 5);
    container.erase(squares, 0);
    container.push(squares, 100);
    line("squares", cast<str>(container.size(squares)) + " items, last " + cast<str>(squares[container.size(squares) - 1]));
    line("popped", cast<str>(container.pop(squares)));

    // A handle aliases; `container.copy` is the one way to get independent storage.
    var alias: Vector<i32> = squares;
    var snapshot: Vector<i32> = container.copy(squares);
    container.clear(squares);
    line("alias / snapshot", cast<str>(container.size(alias)) + " / " + cast<str>(container.size(snapshot)));

    // ------------------------------------------ LinkedList<T>, nodes, O(n) []
    var queue: LinkedList<str> = LinkedList<str>{"bru", "cle"};
    container.insert(queue, 0, "ana");
    container.push(queue, "dan");
    line("front", container.erase(queue, 0));
    line("back", container.pop(queue));
    line("left", cast<str>(container.size(queue)) + " (" + queue[0] + ", " + queue[1] + ")");

    // --------------------------------------- Set<T>, insertion order, unique
    var seen: Set<str> = Set<str>{"red", "green", "red"};
    line("added blue", cast<str>(container.add(seen, "blue")));
    line("added red again", cast<str>(container.add(seen, "red")));
    line("has green", cast<str>(container.contains(seen, "green")));
    line("dropped green", cast<str>(container.remove(seen, "green")));

    var names: Vector<str> = Vector<str>{};
    var i: i32 = 0;
    while (i < container.size(seen)) {
        container.push(names, seen[i]);
        i = i + 1;
    }
    line("seen", join(names));

    // ------------------------------------------ SortedSet<T>, ascending order
    var ranked: SortedSet<i32> = SortedSet<i32>{40, 10, 30, 10};
    container.add(ranked, 20);
    var asText: Vector<str> = Vector<str>{};
    i = 0;
    while (i < container.size(ranked)) {
        container.push(asText, cast<str>(ranked[i]));
        i = i + 1;
    }
    line("ranked", join(asText));
    line("has 30", cast<str>(container.contains(ranked, 30)));

    // -------------------------------- HashMap<K, V>, keyed by value, one way in
    // `m[key] = value` inserts when the key is new and overwrites when it is
    // not, so it is the only way to put an entry in.
    var ages: HashMap<str, i32> = HashMap<str, i32>{"ana": 31, "bruno": 27};
    ages["carla"] = 45;
    ages["ana"] = 32;
    line("ana", cast<str>(ages["ana"]));
    line("has bruno", cast<str>(container.contains(ages, "bruno")));
    line("dropped bruno", cast<str>(container.remove(ages, "bruno")));

    // `container.keys` hands back a Vector in insertion order: that is how a map
    // is walked, since `m[k]` is already keyed by value.
    const who: Vector<str> = container.keys(ages);
    var pairs: Vector<str> = Vector<str>{};
    i = 0;
    while (i < container.size(who)) {
        container.push(pairs, who[i] + "=" + cast<str>(ages[who[i]]));
        i = i + 1;
    }
    line("ages", join(pairs));

    // Reading a key that is not there traps -- binZ has no `null`, so
    // `container.contains` is the guard.
    line("has zed", cast<str>(container.contains(ages, "zed")));

    // A str is not a container, so its size comes from `binz/string`.
    line("size of a str", cast<str>(string.size("binZ")));
    return 0;
}
